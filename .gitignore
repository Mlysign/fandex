# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Alternate build dir for a second concurrent `next dev` (npm run dev:alt) —
# see the distDir comment in next.config.ts.
/.next-alt/
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

node_modules/
.next/
data/
.env
# Claude Code local config.
# NB: `.claude/*`, not `.claude/` — git never descends into an excluded
# DIRECTORY, so a `!` negation under one can never take effect. Excluding the
# contents instead is what makes the plans exception below work.
.claude/*
# Session plans ARE the audit trail of what was planned vs what shipped (one
# session writes the plan, another executes it), so they belong in history.
!.claude/plans/

# H2a verification artifacts (see migration7.dryrun.test.ts)
migration7-out.txt
probe-out.txt

# Android TWA package (P15/P16). NEVER commit this: signing.keystore is the
# upload key and signing-key-info.txt holds its passwords in PLAINTEXT.
# The folder is inside OneDrive, so it is backed up without being in git.
android-package/

# /design working files: keep the .dc.html sources + canvas.json, never the ~2MB seeded canvas
.design/fandex-*.html
