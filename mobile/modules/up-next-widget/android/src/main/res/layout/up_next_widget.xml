<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/up_next_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/up_next_widget_background"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="12dp"
  android:paddingEnd="12dp"
  android:paddingBottom="12dp">

  <!-- The app's section heading, in its serif. Drawn by WidgetText: see there for why it is a picture. -->
  <ImageView
    android:id="@+id/up_next_heading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/up_next_widget_name"
    android:paddingStart="4dp"
    android:paddingBottom="8dp"
    android:scaleType="fitStart" />

  <ListView
    android:id="@+id/up_next_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:divider="@android:color/transparent"
    android:dividerHeight="8dp"
    android:scrollbars="none" />

  <TextView
    android:id="@+id/up_next_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="16dp"
    android:text="@string/up_next_widget_empty"
    android:textColor="#9A8F80"
    android:textSize="13sp" />
</LinearLayout>
