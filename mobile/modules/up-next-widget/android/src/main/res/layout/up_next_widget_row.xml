<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/up_next_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:minHeight="52dp"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingEnd="10dp">

  <LinearLayout
    android:id="@+id/up_next_open"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
      android:id="@+id/up_next_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#EDE7DC"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/up_next_episode"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#9A8F80"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/up_next_tick"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="@drawable/up_next_widget_tick"
    android:contentDescription="@string/up_next_widget_tick"
    android:gravity="center"
    android:text="✓"
    android:textColor="#C8A24B"
    android:textSize="18sp" />
</LinearLayout>
