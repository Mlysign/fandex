<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name=".UpNextWidgetProvider"
      android:exported="false"
      android:label="@string/up_next_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/up_next_widget_info" />
    </receiver>
    <service
      android:name=".UpNextWidgetService"
      android:exported="false"
      android:permission="android.permission.BIND_REMOTEVIEWS" />
    <!-- Takes every tap on the widget and is gone before it draws. Its own task,
         kept out of Recents, so a tick never brings the app's screen forward. -->
    <activity
      android:name=".WidgetTapActivity"
      android:exported="false"
      android:theme="@android:style/Theme.NoDisplay"
      android:taskAffinity=""
      android:excludeFromRecents="true"
      android:noHistory="true" />
    <receiver
      android:name=".UpNextTickReceiver"
      android:exported="false" />
  </application>
</manifest>
